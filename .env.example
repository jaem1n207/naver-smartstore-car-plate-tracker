# Local mock defaults. Replace the placeholder values only on the fixed-IP server.
NODE_ENV=development
TZ=Asia/Seoul
LOG_LEVEL=info
NAVER_API_MODE=mock
ALLOW_LIVE_NAVER_API=false
NAVER_API_BASE_URL=https://api.commerce.naver.com/external
SYNC_CRON=*/5 * * * *

STORE_A_NAME=스토어A
STORE_A_BASE_URL=https://smartstore.naver.com/example-store-a
STORE_A_CLIENT_ID=mock-store-a-client-id
STORE_A_CLIENT_SECRET=mock-store-a-client-secret
STORE_A_ACCOUNT_ID=mock-store-a-account-id

STORE_B_NAME=스토어B
STORE_B_BASE_URL=https://smartstore.naver.com/example-store-b
STORE_B_CLIENT_ID=mock-store-b-client-id
STORE_B_CLIENT_SECRET=mock-store-b-client-secret
STORE_B_ACCOUNT_ID=mock-store-b-account-id

GOOGLE_SHEETS_SPREADSHEET_ID=example-spreadsheet-id

# Recommended on a VM: absolute path to the protected service account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=/opt/naver-smartstore-car-plate-tracker/secrets/google-service-account.json

# Alternative for a secret manager. Configure this OR GOOGLE_APPLICATION_CREDENTIALS, never both.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
