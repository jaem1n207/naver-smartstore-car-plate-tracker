[Unit]
Description=Recover Naver Smartstore car plate tracker deployment state
Before=car-plate-tracker.service
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/recover-car-plate-tracker
TimeoutStartSec=10min
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
ReadWritePaths=/opt/naver-smartstore-car-plate-tracker
ReadWritePaths=/var/lib/naver-smartstore-car-plate-tracker/deployment
